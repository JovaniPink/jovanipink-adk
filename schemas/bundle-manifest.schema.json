{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JovaniPink/jovanipink-adk/schemas/bundle-manifest.schema.json",
  "title": "JovaniPink ADK bundle manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bundle_id",
    "bundle_version",
    "source_revision",
    "created_at",
    "skills",
    "artifact_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1"},
    "bundle_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "bundle_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "path", "files"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 64},
          "path": {"type": "string", "pattern": "^skills/[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "files": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "sha256"],
              "properties": {
                "path": {"type": "string"},
                "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
              }
            }
          }
        }
      }
    }
  }
}
